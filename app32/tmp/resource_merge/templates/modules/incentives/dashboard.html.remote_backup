{% extends "layouts/app.html" %}

{% block page_title %}Plano de Incentivos{% endblock %}

{% block extra_css %}
<link rel="stylesheet" href="{{ url_for('static', filename='css/incentives.css') }}">
{% endblock %}

{% block content %}
<div class="incentive-container">
    <div class="incentive-header">
        <div>
            <h1 class="incentive-title">Plano de Incentivos</h1>
            <p style="color: var(--text-secondary)">Gestão estratégica de bônus, metas e meritocracia.</p>
        </div>
        <div class="header-actions">
            <a href="{{ url_for('incentives.spider_web') }}" class="vs-btn vs-btn-primary">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right: 8px;">
                    <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"></path>
                </svg>
                Ver Teia de Conexões
            </a>
        </div>
    </div>

    <div class="vs-grid-cols-3" style="margin-bottom: 2rem;">
        <div class="incentive-glass incentive-card">
            <h3 style="margin-bottom: 0.5rem;">Indicadores Ativos</h3>
            <div style="font-size: 2rem; font-weight: 700;">{{ stats.indicators }}</div>
            <p style="font-size: 0.875rem; color: #10b981;">Monitorando módulos core</p>
        </div>
        <div class="incentive-glass incentive-card">
            <h3 style="margin-bottom: 0.5rem;">Cálculo Atual</h3>
            <div style="font-size: 2rem; font-weight: 700;">R$ {{ "{:,.2f}".format(stats.total_payout).replace(',', 'X').replace('.', ',').replace('X', '.') }}</div>
            <p style="font-size: 0.875rem; color: var(--text-secondary)">Provisionado para {{ stats.participants }} colaboradores</p>
        </div>
        <div class="incentive-glass incentive-card">
            <h3 style="margin-bottom: 0.5rem;">Governança</h3>
            <div style="font-size: 2rem; font-weight: 700; color: #10b981;">100%</div>
            <p style="font-size: 0.875rem; color: var(--text-secondary)">Último fechamento: {{ stats.last_closing.strftime('%d/%m/%Y') if stats.last_closing else 'N/A' }}</p>
        </div>
    </div>

    <div class="vs-grid-cols-2" style="gap: 2rem; margin-bottom: 2rem;">
        <div class="incentive-glass">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
                <h2 style="font-size: 1.5rem;">Configurações (RuleSets)</h2>
                <button class="vs-btn vs-btn-outline vs-btn-sm" onclick="alert('Funcionalidade em desenvolvimento')">Novo Plano</button>
            </div>

            <div class="vs-table-container">
                <table class="vs-table">
                    <thead>
                        <tr>
                            <th>Nome</th>
                            <th>Periodicidade</th>
                            <th>Status</th>
                            <th>Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for rs in rule_sets %}
                        <tr>
                            <td style="font-weight: 600;">{{ rs.name }} (v{{ rs.version }})</td>
                            <td>{{ rs.periodicity | upper }}</td>
                            <td>
                                {% if rs.is_active %}
                                <span class="vs-badge vs-badge-success">Ativo</span>
                                {% else %}
                                <span class="vs-badge vs-badge-secondary">Inativo</span>
                                {% endif %}
                            </td>
                            <td>
                                <div style="display: flex; gap: 0.5rem;">
                                    <a href="{{ url_for('incentives.manage_rules', rule_set_id=rs.id) }}" class="vs-btn vs-btn-sm vs-btn-ghost">Configurar</a>
                                    <button class="vs-btn vs-btn-sm vs-btn-primary" onclick="simularCalculo({{ rs.id }})">Rodar</button>
                                </div>
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>

        <div class="incentive-glass">
            <h2 style="font-size: 1.5rem; margin-bottom: 1.5rem;">Histórico de Fechamentos</h2>
            <div class="vs-table-container">
                <table class="vs-table">
                    <thead>
                        <tr>
                            <th>Data</th>
                            <th>Período</th>
                            <th>Valor Total</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for calc in history %}
                        <tr>
                            <td>{{ calc.created_at.strftime('%d/%m/%Y') }}</td>
                            <td style="font-size: 0.75rem; color: var(--text-secondary);">{{ calc.period_start.strftime('%d/%m') }} - {{ calc.period_end.strftime('%d/%m') }}</td>
                            <td style="font-weight: 600;">R$ {{ "{:,.2f}".format(calc.total_distributed).replace(',', 'X').replace('.', ',').replace('X', '.') }}</td>
                            <td><span class="vs-badge vs-badge-primary">{{ calc.status.upper() }}</span></td>
                        </tr>
                        {% else %}
                        <tr>
                            <td colspan="4" style="text-align: center; color: var(--text-secondary); padding: 2rem;">Nenhum histórico disponível.</td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<script>
async function simularCalculo(ruleSetId) {
    const today = new Date().toISOString().split('T')[0];
    const thirtyDaysAgo = new Date(Date.now() - 30 * 24 * 60 * 60 * 1000).toISOString().split('T')[0];
    
    try {
        const response = await fetch('/api/incentives/calculate', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                rule_set_id: ruleSetId,
                start_date: thirtyDaysAgo,
                end_date: today
            })
        });
        const data = await response.json();
        alert(`Cálculo Simulado!\nTotal: R$ ${data.total_payout}\nParticipantes: ${data.participants.length}`);
    } catch (e) {
        alert('Erro ao simular cálculo.');
    }
}
</script>
{% endblock %}
