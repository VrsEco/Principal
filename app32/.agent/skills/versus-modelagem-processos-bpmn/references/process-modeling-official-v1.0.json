{
  "protocol_version": "process-modeling-official-v1.0",
  "journey_version": "process-modeling-maturity-v1.0",
  "status": "canonical_methodology",
  "scope": "process_modeling",
  "required_context": [
    "company_id",
    "process_id",
    "process_code",
    "bpmn_version_or_draft_reference"
  ],
  "source_ingestion_contract": {
    "accepted_sources": [
      "audio",
      "text",
      "legacy_document",
      "mixed"
    ],
    "required_actions": [
      "preserve_source_provenance",
      "extract_atomic_statements",
      "record_transcription_uncertainty",
      "assess_source_currency",
      "reconcile_legacy_content_with_current_mcp_state_and_executors"
    ],
    "source_currency_statuses": [
      "current_confirmed",
      "current_unconfirmed",
      "legacy",
      "conflicting",
      "unknown"
    ],
    "legacy_document_is_current_truth": false
  },
  "element_classification_contract": {
    "classification_requires_evidence_and_rationale": true,
    "single_statement_may_yield_multiple_elements": true,
    "classify_by_verb_or_indentation_only": false,
    "ambiguous_classification_status": "hypothesis_or_pending",
    "client_squad_validates_operational_reality": true,
    "versus_squad_validates_level_boundary_and_factoring": true,
    "types": {
      "macroprocess": "permanent_large_delivery_or_capability_grouping_coherent_processes",
      "process": "recurring_managed_transformation_with_trigger_input_output_receiver_owner_and_cycle",
      "activity": "executable_unit_with_micro_delivery_state_change_or_handoff",
      "procedure_step": "how_to_instruction_without_independent_business_output_receiver_handoff_or_cycle",
      "pop": "versioned_instructional_artifact_for_one_or_more_activities",
      "checklist": "verification_or_control_artifact_with_items_criteria_result_and_evidence",
      "form": "structured_data_capture_with_fields_validation_purpose_and_destination",
      "indicator": "measure_with_formula_unit_source_frequency_target_and_owner",
      "business_rule": "condition_that_changes_path_or_result",
      "event": "message_time_condition_or_occurrence_that_starts_waits_interrupts_or_ends_flow",
      "data_document_evidence": "input_output_or_proof_not_executable_work",
      "resource_system": "means_asset_or_capability_enabling_execution",
      "project": "temporary_effort_to_create_correct_or_improve_permanent_capability"
    },
    "procedure_step_belongs_inside_pop": true,
    "pop_is_activity": false
  },
  "maturity_contract": {
    "registered_diagram_is_not_methodological_maturity": true,
    "valid_xml_is_not_methodological_maturity": true,
    "published_model_is_not_implementation_maturity": true,
    "implementation_maturity_is_not_operational_performance": true,
    "universal_percentage_score": false
  },
  "dimensions": [
    {
      "key": "contract",
      "label": "Contrato",
      "questions": [
        "Objetivo e saída estão distintos?",
        "Gatilho, fronteira, fornecedores, entradas, saídas e recebedores estão coerentes nos dois sentidos?",
        "Cada caminho final produz resultado intencional?"
      ],
      "minimum_evidence": [
        "objetivo",
        "fronteira",
        "gatilho",
        "sipoc_bidirecional",
        "responsavel_processo"
      ],
      "quality_criteria": [
        "sem_atividade_sem_contribuicao",
        "sem_saida_sem_recebedor",
        "sem_loop_artificial"
      ]
    },
    {
      "key": "reality_alignment",
      "label": "Aderência à realidade",
      "questions": [
        "O AS-IS foi sustentado por executores e evidências?",
        "Exceções, retrabalho e handoffs reais estão explícitos?",
        "Fatos, hipóteses e decisões estão separados?"
      ],
      "minimum_evidence": [
        "fontes_operacionais",
        "validacao_cliente",
        "gaps_as_is"
      ],
      "quality_criteria": [
        "rastreabilidade_evidencia_fluxo",
        "hipoteses_identificadas"
      ]
    },
    {
      "key": "bpmn_semantics",
      "label": "Semântica BPMN",
      "questions": [
        "Eventos, atividades, gateways, raias e finais representam corretamente o trabalho?",
        "Decisões e sincronizações são reais e compreensíveis?",
        "Todos os nós possuem conectividade válida?"
      ],
      "minimum_evidence": [
        "xml_bpmn",
        "validacao_estrutural",
        "revisao_visual"
      ],
      "quality_criteria": [
        "codigos_coerentes",
        "caminhos_completos",
        "gateways_semanticos",
        "lanes_executoras"
      ]
    },
    {
      "key": "executability",
      "label": "Executabilidade",
      "questions": [
        "Responsável do processo e times executores estão distintos?",
        "Rotina, recursos e artefatos necessários foram decididos?",
        "POPs e indicadores foram mantidos no mínimo necessário?"
      ],
      "minimum_evidence": [
        "responsabilidades",
        "rotina_gatilho",
        "decisoes_artefatos",
        "artifact_requirements_by_activity",
        "artifact_development_status"
      ],
      "quality_criteria": [
        "pop_seletivo",
        "indicadores_minimos",
        "tarefas_automaticas_com_contrato"
      ]
    },
    {
      "key": "governance",
      "label": "Governança",
      "questions": [
        "Versão, tenant, gates e decisões estão rastreáveis?",
        "AS-IS e TO-BE preservam relação explícita?",
        "Publicação e releitura foram autorizadas e evidenciadas?"
      ],
      "minimum_evidence": [
        "company_id",
        "versao",
        "gates",
        "historico_decisoes",
        "component_versions",
        "modeling_baseline",
        "pending_register"
      ],
      "quality_criteria": [
        "mcp_first",
        "human_gate",
        "sem_publicacao_autonoma"
      ]
    },
    {
      "key": "learning",
      "label": "Aprendizado",
      "questions": [
        "Existem sinais para comparar modelo e execução?",
        "Mudanças e desvios possuem critérios de reavaliação?",
        "Um novo ciclo preserva a última versão vigente?"
      ],
      "minimum_evidence": [
        "gatilhos_reavaliacao",
        "historico_ciclos"
      ],
      "quality_criteria": [
        "revisao_por_evento_ou_cadencia",
        "historico_imutavel"
      ]
    }
  ],
  "journey": {
    "entry_state": "collecting_evidence",
    "states": [
      {
        "key": "collecting_evidence",
        "owner": "squad_cliente",
        "exit_evidence": [
          "fontes_e_fatos_operacionais"
        ]
      },
      {
        "key": "contracting_process",
        "owner": "squad_versus",
        "exit_evidence": [
          "contrato_sipoc_bidirecional"
        ]
      },
      {
        "key": "mapping_as_is",
        "owner": "squad_cliente",
        "exit_evidence": [
          "bpmn_as_is_em_discussao"
        ]
      },
      {
        "key": "designing_to_be",
        "owner": "squad_versus",
        "exit_evidence": [
          "bpmn_to_be_rastreavel"
        ]
      },
      {
        "key": "completing_operational_model",
        "owner": "squad_versus",
        "exit_evidence": [
          "decisoes_responsabilidades_rotina_pops_indicadores_artefatos"
        ]
      },
      {
        "key": "awaiting_client_validation",
        "owner": "squad_cliente",
        "exit_evidence": [
          "validacao_realidade"
        ]
      },
      {
        "key": "awaiting_versus_validation",
        "owner": "squad_versus",
        "exit_evidence": [
          "validacao_metodologica"
        ]
      },
      {
        "key": "awaiting_consultant_decision",
        "owner": "consultor",
        "exit_evidence": [
          "decisao_explicita"
        ]
      },
      {
        "key": "approved_for_publication",
        "owner": "executor_autorizado",
        "exit_evidence": [
          "autorizacao_publicacao"
        ]
      },
      {
        "key": "published",
        "owner": "executor_autorizado",
        "exit_evidence": [
          "publicacao_e_releitura"
        ]
      },
      {
        "key": "due_for_review",
        "owner": "consultor",
        "exit_evidence": [
          "novo_ciclo_aberto"
        ]
      },
      {
        "key": "blocked",
        "owner": "responsavel_pelo_bloqueio",
        "exit_evidence": [
          "condicao_desbloqueio_atendida"
        ]
      }
    ]
  },
  "gates": [
    {
      "key": "client_validation",
      "actor": "squad_cliente",
      "scope": "fatos_e_as_is"
    },
    {
      "key": "versus_validation",
      "actor": "squad_versus",
      "scope": "metodo_fronteira_e_to_be"
    },
    {
      "key": "technical_validation",
      "actor": "engenharia",
      "scope": "xml_capabilities_importacao",
      "conditional": true
    },
    {
      "key": "consultant_decision",
      "actor": "consultor",
      "scope": "aprovacao_ajuste_ou_rejeicao"
    },
    {
      "key": "publication",
      "actor": "executor_autorizado",
      "scope": "publicar_e_reler"
    }
  ],
  "reassessment_triggers": [
    "mudanca_de_objetivo_ou_fronteira",
    "mudanca_relevante_no_sipoc",
    "desvio_recorrente_entre_modelo_e_execucao",
    "excecao_recorrente_nao_modelada",
    "alteracao_regulatoria_ou_tecnologica",
    "revisao_periodica_definida",
    "descoberta_em_entrega_posterior_com_impacto_em_entrega_anterior",
    "artefato_revela_necessidade_de_revisar_atividade_ou_premissa"
  ],
  "executive_view": {
    "default": true,
    "allowed_statuses": [
      "not_defined",
      "building",
      "validating",
      "validated",
      "review_required"
    ],
    "fields_per_dimension": [
      "status",
      "main_gap",
      "next_action"
    ],
    "dimensions": [
      {
        "key": "flow",
        "label": "Fluxo",
        "strategic_question": "As atividades e saídas contribuem para os objetivos da empresa?"
      },
      {
        "key": "operational_artifacts",
        "label": "POP / Checklist / Formulários",
        "strategic_question": "Os artefatos reduzem risco ou geram dados realmente necessários?",
        "maturity_checks": [
          "necessity",
          "activity_link",
          "configuration",
          "version",
          "required_flag",
          "completion_policy",
          "evidence",
          "strategic_contribution"
        ],
        "visual_contract": {
          "semantic_truth": [
            "artifact_type",
            "bpmn_element_id",
            "definition_id",
            "version",
            "status"
          ],
          "color_is_reading_aid_only": true,
          "marker_presence_does_not_prove_maturity": true,
          "canonical_markers": {
            "pop": {
              "label": "POP",
              "stroke": "#2563eb",
              "fill": "#eff6ff"
            },
            "form": {
              "label": "FORM",
              "stroke": "#7c3aed",
              "fill": "#f5f3ff"
            },
            "check": {
              "label": "CHECK",
              "stroke": "#059669",
              "fill": "#ecfdf5"
            }
          }
        }
      },
      {
        "key": "indicators",
        "label": "Indicadores",
        "strategic_question": "Os poucos indicadores escolhidos mostram contribuição para o resultado estratégico?"
      },
      {
        "key": "routine",
        "label": "Rotina",
        "strategic_question": "O gatilho e a frequência permitem alcançar as metas no tempo necessário?"
      },
      {
        "key": "resources",
        "label": "Recursos",
        "strategic_question": "Existem recursos e capacidade para executar o processo conforme a estratégia?"
      },
      {
        "key": "accountability",
        "label": "Responsável / Time Executor",
        "strategic_question": "Responsabilidade, competência e capacidade estão claramente definidas?"
      }
    ],
    "technical_detail": "on_demand"
  },
  "conversation_contract": {
    "mode": "maturity_conversation",
    "one_dimension_at_a_time": true,
    "one_question_at_a_time": true,
    "max_questions_before_synthesis": 3,
    "required_context": [
      "organizational_identity",
      "strategic_objectives",
      "process_architecture",
      "current_modeling"
    ],
    "research_policy": {
      "mcp_first_for_internal_state": true,
      "external_search_only_if_decision_relevant": true,
      "separate_fact_source_inference_recommendation": true,
      "cite_external_sources": true
    },
    "response_contract": [
      "conclusion",
      "strategic_contribution",
      "dimension_status",
      "single_next_action"
    ],
    "canonical_change_requires_human_approval": true,
    "coordinator_exposes_single_conversation": true,
    "new_agent_required": false
  },
  "runtime_activation": {
    "agent_and_squad_guidance": "active",
    "tenant_owned_persistence": "requires_technical_slice",
    "deterministic_next_action_mcp": "requires_technical_slice"
  },
  "delivery_model": {
    "sequential_and_evolutionary": true,
    "independent_component_versions": true,
    "pre_modeling_assessment": {
      "required": true,
      "owner": "squad_cliente",
      "timing": "before_mapping_or_revising_as_is",
      "mcp_first": true,
      "checks": [
        "process_architecture",
        "process_premises",
        "sipoc",
        "flow",
        "flow_artifacts"
      ],
      "output": "delivery_coverage_matrix",
      "element_status_contract": "definition_status_contract",
      "structural_divergence_handoff": "squad_versus"
    },
    "architecture_delivery": {
      "code": "1",
      "key": "process_architecture",
      "label": "Arquitetura de Processos",
      "scope": [
        "macroprocesses",
        "objectives",
        "owners",
        "macroprocess_relationships"
      ]
    },
    "modeling_deliveries": [
      {
        "code": "2.1",
        "key": "process_premises",
        "label": "Premissas dos Processos",
        "scope": [
          "objective",
          "scope",
          "start",
          "end",
          "accountable_owner",
          "executor_team",
          "indicators",
          "routine",
          "resources",
          "constraints"
        ]
      },
      {
        "code": "2.2",
        "key": "sipoc",
        "label": "SIPOC",
        "scope": [
          "suppliers",
          "inputs",
          "macro_activities",
          "outputs",
          "customers",
          "external_interfaces"
        ]
      },
      {
        "code": "2.3",
        "key": "flow",
        "label": "Fluxo",
        "scope": [
          "bpmn",
          "activities",
          "events",
          "gateways",
          "responsibilities",
          "exceptions",
          "artifact_requirements_by_activity"
        ],
        "artifact_rule": "identify_and_link_requirements_only"
      },
      {
        "code": "2.4",
        "key": "flow_artifacts",
        "label": "Artefatos do Fluxo",
        "scope": [
          "pop",
          "checklist",
          "form",
          "other_activity_artifacts"
        ],
        "artifact_rule": "develop_validate_version_and_link_artifacts_identified_in_flow"
      }
    ],
    "downstream_discovery_can_reopen_prior_delivery": true,
    "change_control": [
      "reason",
      "impact",
      "new_component_version",
      "revalidation_when_material"
    ],
    "baseline": {
      "required_components": [
        "process_premises",
        "sipoc",
        "flow",
        "flow_artifacts"
      ],
      "component_versions_may_differ": true,
      "preserve_prior_versions": true
    }
  },
  "definition_status_contract": {
    "allowed_statuses": [
      "defined",
      "hypothesis",
      "pending",
      "not_applicable"
    ],
    "pending_required_fields": [
      "missing_definition",
      "definition_owner",
      "revisit_stage",
      "impact"
    ],
    "allowed_impacts": [
      "blocking",
      "non_blocking"
    ],
    "blocking_pending_prevents_implementation_approval": true,
    "non_blocking_pending_may_enter_conditional_baseline": true,
    "unknown_information_must_not_be_invented": true
  }
}
