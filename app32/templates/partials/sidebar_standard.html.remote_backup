<script>
    if (typeof toggleSidebarGroup === 'undefined') {
        function toggleSidebarGroup(btn, event) {
            if (event) {
                event.preventDefault();
                event.stopPropagation();
            }

            if (!btn) {
                return false;
            }

            const group = btn.closest('.sidebar-group, .sidebar-subgroup');
            if (!group) {
                return false;
            }

            group.classList.toggle('open');
            return false;
        }
    }

    document.querySelectorAll('.sidebar-nav .nav-button, .sidebar-nav .subgroup-button').forEach((button) => {
        button.setAttribute('type', 'button');
    });
</script>

