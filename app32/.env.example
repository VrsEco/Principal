# Server Configuration
FLASK_APP=app.py
FLASK_ENV=development
DEBUG=True

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_NAME=gestao_versus
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_PORT=5432

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
AI_PROVIDER=openai
AI_API_KEY=your_openai_api_key_here
AI_BASE_URL=https://api.openai.com/v1
AI_WEBHOOK_URL=

# Email Integration
EMAIL_PROVIDER=smtp
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your_email@example.com
MAIL_PASSWORD=your_app_password_here
EMAIL_WEBHOOK_URL=
EMAIL_INBOUND_PROTOCOL=pop3
EMAIL_INBOUND_HOST=pop.gmail.com
EMAIL_INBOUND_PORT=995
EMAIL_INBOUND_USERNAME=your_email@example.com
EMAIL_INBOUND_PASSWORD=your_app_password_here
EMAIL_INBOUND_USE_SSL=true
EMAIL_AUTO_REPLY=false

# WhatsApp Integration
WHATSAPP_PROVIDER=z-api
WHATSAPP_API_KEY=your_whatsapp_api_key_here
WHATSAPP_INSTANCE_ID=your_whatsapp_instance_id_here
WHATSAPP_CLIENT_TOKEN=
WHATSAPP_WEBHOOK_URL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Telegram Integration
TELEGRAM_PROVIDER=bot_api
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_TOKEN_DEV=
TELEGRAM_BOT_TOKEN_PROD=
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_PATH=/webhook/telegram
TELEGRAM_ENV=dev

# Instagram Integration
INSTAGRAM_PROVIDER=meta
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
INSTAGRAM_WEBHOOK_URL=
INSTAGRAM_GRAPH_API_BASE=https://graph.facebook.com/v21.0
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_VERIFY_TOKEN=

# Telegram Webhook Setup (Opcional)
EXTERNAL_URL=https://app.gestaoversus.com.br
TELEGRAM_SETUP_WEBHOOK=true
NGROK_AUTH_TOKEN=your_ngrok_token_for_dev

# OAuth/OIDC do MCP remoto — fail-closed e desligado por padrão.
# Preencha somente por ambiente/secret manager. Não salve access token,
# refresh token, client secret ou chave privada neste arquivo.
APP32_MCP_HTTP_ENABLE_OAUTH=0
APP32_MCP_OIDC_PILOT_ROUTE_ENABLED=0
# Coorte financeira OAuth separada; somente leituras analytics tenant-safe.
APP32_MCP_OIDC_PILOT_ANALYTICS_ROUTE_ENABLED=0
APP32_MCP_OIDC_ENABLED_SURFACES=
APP32_MCP_USE_PRINCIPAL_GRANTS=0
APP32_MCP_PUBLIC_BASE_URL=
APP32_MCP_OIDC_ISSUER=
APP32_MCP_OIDC_AUDIENCE=
APP32_MCP_OIDC_JWKS_URL=
APP32_MCP_OIDC_ALGORITHMS=RS256
APP32_MCP_OIDC_ALLOWED_CLIENT_IDS=
APP32_MCP_OIDC_REQUIRED_SCOPES=mcp:access
APP32_MCP_OIDC_EXPECTED_TOKEN_TYPE=
APP32_MCP_OIDC_CA_BUNDLE=
APP32_MCP_OIDC_LEEWAY_SECONDS=30
APP32_MCP_OIDC_JWKS_TIMEOUT_SECONDS=5
APP32_MCP_OIDC_JWKS_REFRESH_COOLDOWN_SECONDS=15
APP32_MCP_OIDC_JWKS_UNKNOWN_KID_CACHE_SIZE=64
