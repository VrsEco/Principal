# Copiar para ../secure/keycloak.env (fora de www e fora do Git), chmod 600.
# Substituir todos os marcadores por valores aleatórios exclusivos do serviço.
POSTGRES_DB=keycloak
POSTGRES_USER=keycloak
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_DATABASE_PASSWORD

KC_DB=postgres
KC_DB_URL=jdbc:postgresql://postgres:5432/keycloak
KC_DB_USERNAME=keycloak
KC_DB_PASSWORD=REPLACE_WITH_RANDOM_DATABASE_PASSWORD
KC_HOSTNAME=https://id.gestaoversus.com.br
KC_HTTP_ENABLED=true
KC_PROXY_HEADERS=xforwarded
KC_HEALTH_ENABLED=true
KC_METRICS_ENABLED=true
KC_BOOTSTRAP_ADMIN_USERNAME=bootstrap-admin
KC_BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_RANDOM_BOOTSTRAP_PASSWORD

# Runtime limitado para coexistir com APP32; reavaliar antes de ampliar coorte.
JAVA_OPTS_KC_HEAP=-XX:MaxRAMPercentage=65 -XX:InitialRAMPercentage=30
