# Template local de homologação Keycloak sem Docker e com TLS.
# Copie para fora do repositório e substitua somente os placeholders.
# Nunca versionar password, bootstrap admin password, access token ou private key.

KC_DB=postgres
KC_DB_URL=jdbc:postgresql://127.0.0.1:5432/keycloak_local_hml
KC_DB_USERNAME=keycloak_local_hml_user
# KCRAW_DB_PASSWORD=<armazenar fora do Git; preserva caracteres $ literalmente>

KC_BOOTSTRAP_ADMIN_USERNAME=<admin-local-nao-compartilhado>
# KC_BOOTSTRAP_ADMIN_PASSWORD=<armazenar fora do Git>

# Exclusivo para homologação local; não reutilizar em produção.
# O verifier APP32 só aceita issuer/JWKS HTTPS: não habilitar HTTP como
# alternativa. Gere o PKCS12 fora do Git, com SAN para localhost e 127.0.0.1.
KC_HTTP_ENABLED=false
# Mesmo com HTTP desabilitado, este host também limita o listener HTTPS.
KC_HTTP_HOST=127.0.0.1
KC_HTTPS_PORT=8443
KC_HTTPS_KEY_STORE_FILE=C:/GestaoVersus/services/keycloak-26.7.3/conf/keycloak-local.p12
# KCRAW_HTTPS_KEY_STORE_PASSWORD=<armazenar fora do Git>
KC_HOSTNAME=https://localhost:8443
KC_HOSTNAME_STRICT=true
KC_HEALTH_ENABLED=true
KC_METRICS_ENABLED=true
# Management fica explicitamente loopback; em TLS herda o keystore principal.
KC_HTTP_MANAGEMENT_HOST=127.0.0.1
KC_HTTP_MANAGEMENT_PORT=9000
