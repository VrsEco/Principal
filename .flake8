[flake8]
ignore = E501, W503, E203, E402
exclude =
    .git,
    __pycache__,
    venv,
    .venv,
    .codex_temp*,
    app32/.venv,
    app32/.codex_temp*,
    app31,
    docs,
    migrations,
    static,
    backups,
    uploads,
    temp_relatorios,
    temp_pdfs,
    node_modules,
    data,
    archive,
    seeds,
    .agent,
    instance,
    knowledge,
    logs,
    tmp,
    tmp_*,
    tmp_edge_profile,
    scratch
max-line-length = 120
